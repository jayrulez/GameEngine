        0x00, 0x00, 0xC6, 0xC6, 0xC6, 0xC6, 0x7E, 0x00, // u (117)
        0x00, 0x00, 0xC6, 0xC6, 0xC6, 0x6C, 0x38, 0x00, // v (118)
        0x00, 0x00, 0xC6, 0xC6, 0xD6, 0xFE, 0x6C, 0x00, // w (119)
        0x00, 0x00, 0xC6, 0x6C, 0x38, 0x6C, 0xC6, 0x00, // x (120)
        0x00, 0x00, 0xC6, 0xC6, 0xC6, 0x7E, 0x06, 0x7C, // y (121)
        0x00, 0x00, 0xFE, 0x0C, 0x38, 0x60, 0xFE, 0x00, // z (122)
        0x0E, 0x18, 0x18, 0x70, 0x18, 0x18, 0x0E, 0x00, // { (123)
        0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, // | (124)
        0x70, 0x18, 0x18, 0x0E, 0x18, 0x18, 0x70, 0x00, // } (125)
        0x76, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // ~ (126)
    };

    // Bake the font into a single-channel (R8) atlas (kTextureWidth x kTextureHeight bytes). A trailing
    // solid white block (slot kCharCount) is emitted for filled-rect drawing (GetSolidBlockUV).
    inline Array<u8> GenerateTextureData()
    {
        Array<u8> data;
        data.Resize(static_cast<usize>(kTextureWidth) * static_cast<usize>(kTextureHeight));
        for (auto& b : data)
        {
            b = 0;
        }

        for (i32 charIdx = 0; charIdx < kCharCount; ++charIdx)
        {
            const i32 baseX = (charIdx % kCharsPerRow) * kCharWidth;
            const i32 baseY = (charIdx / kCharsPerRow) * kCharHeight;
            for (i32 row = 0; row < kCharHeight; ++row)
            {
                const u8 rowByte = kFontData[charIdx * 8 + row];
                for (i32 col = 0; col < kCharWidth; ++col)
                {
                    const u8 bit = static_cast<u8>((rowByte >> (7 - col)) & 1);
                    data[static_cast<usize>((baseY + row) * kTextureWidth + (baseX + col))] =
                        bit ? 255u : 0u;
                }
            }
        }
        // Solid white block in the slot after the last glyph.
        const i32 sBaseX = (kCharCount % kCharsPerRow) * kCharWidth;
        const i32 sBaseY = (kCharCount / kCharsPerRow) * kCharHeight;
        for (i32 row = 0; row < kCharHeight; ++row)
        {
            for (i32 col = 0; col < kCharWidth; ++col)
            {
                const i32 px = sBaseX + col, py = sBaseY + row;
                if (px < kTextureWidth && py < kTextureHeight)
                {
                    data[static_cast<usize>(py * kTextureWidth + px)] = 255u;
                }
            }
        }
        return data;
    }

    // UV rect for the solid white block (filled-rect backgrounds).
    inline void GetSolidBlockUV(f32& u0, f32& v0, f32& u1, f32& v1) noexcept
    {
        const i32 col = kCharCount % kCharsPerRow, row = kCharCount / kCharsPerRow;
        u0 = static_cast<f32>(col * kCharWidth) / static_cast<f32>(kTextureWidth);
        v0 = static_cast<f32>(row * kCharHeight) / static_cast<f32>(kTextureHeight);
        u1 = static_cast<f32>((col + 1) * kCharWidth) / static_cast<f32>(kTextureWidth);
        v1 = static_cast<f32>((row + 1) * kCharHeight) / static_cast<f32>(kTextureHeight);
    }

    // UV rect for a printable-ASCII code point. Returns false (leaves outputs 0) if out of range.
    inline bool GetCharUV(u32 c, f32& u0, f32& v0, f32& u1, f32& v1) noexcept
    {
        u0 = v0 = u1 = v1 = 0.0f;
        if (static_cast<i32>(c) < kFirstChar || static_cast<i32>(c) > kLastChar)
        {
            return false;
        }
        const i32 idx = static_cast<i32>(c) - kFirstChar;
        const i32 col = idx % kCharsPerRow, row = idx / kCharsPerRow;
        u0 = static_cast<f32>(col * kCharWidth) / static_cast<f32>(kTextureWidth);
        v0 = static_cast<f32>(row * kCharHeight) / static_cast<f32>(kTextureHeight);
        u1 = static_cast<f32>((col + 1) * kCharWidth) / static_cast<f32>(kTextureWidth);
        v1 = static_cast<f32>((row + 1) * kCharHeight) / static_cast<f32>(kTextureHeight);
        return true;
    }

} // namespace draconic::render::debug
