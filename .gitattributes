# Patch files must keep LF endings: `git apply` / `patch` match context lines
# byte-for-byte, and a CRLF checkout (core.autocrlf=true on Windows) makes them
# fail against the LF sources they target.
*.patch -text
*.diff -text

# Batch files must be CRLF: cmd.exe can misparse LF-only scripts, notably around labels
# and goto (build-msvc.cmd uses both).
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must be LF, whatever a contributor's core.autocrlf says: a CRLF shebang
# makes Linux reject the script outright ("bad interpreter: /usr/bin/env bash^M"), and these
# are committed from Windows (build-clang.sh, build-gcc.sh).
*.sh text eol=lf
