<Panel id="page-data-views" class="page" gap="18">
    <Label class="page-title" text="Data views"/>
    <Label class="page-lead" white-space="normal"
           text="Views over models: they realise only the rows on screen, and follow the model when it changes. The models are native (a list, a table behind a sorting proxy, a tree)."/>

    <Panel class="section" gap="12">
        <Label class="section-title" text="ListView: 500 rows, virtualised"/>
        <Panel id="views-list" class="view-host" display="stack" justify-items="start" align-items="start"/>
        <Label id="views-picked" class="caption" text="Click a row, or focus the list and use the arrows."/>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="TableView: click a header to sort"/>
        <Panel id="views-table" class="view-host" display="stack" justify-items="start" align-items="start"/>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="TreeView: click the arrows, or use the arrow keys"/>
        <Panel id="views-tree" class="view-host" display="stack" justify-items="start" align-items="start"/>
    </Panel>
</Panel>
