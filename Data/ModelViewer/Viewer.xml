<!--
  The model viewer's window (Documentation/Specs/model-viewer.md): a bar with a tab per open model,
  Open and Screenshot; under it the stage (the 3D view over the animation bar) and the side panel
  (the model's numbers, the view's light, the turntable, the skeleton). With nothing open, the
  stage says how to open a model. Its look is the editor's sheet with the viewer's own after it
  (ModelViewer/viewer.css). Code puts the viewport in `viewer-view`, a tab per model in
  `viewer-tabs` after the Browse and Library tabs, the numbers in `viewer-stats` and the clips in
  `viewer-clip`. With the Browse tab in front, the browser takes the stage's place: the folders,
  the filters and a thumbnail per model under the chosen folder (`viewer-grid`). With the Library
  tab in front, the library: its collections and tags (`viewer-lib-tree`), the search, and the
  models of what is chosen (`viewer-lib-grid`).
-->
<Panel class="viewer">
    <Panel id="viewer-bar" class="panel-toolbar viewer-bar">
        <TabBar id="viewer-tabs" class="viewer-tabs" close-display="always" reorderable="true"/>
        <Button id="viewer-tab-previous" class="icon-button" icon="ModelViewer/Icons/chevron-left.svg" tooltip="The tab before (Ctrl+Shift+Tab)"/>
        <Button id="viewer-tab-next" class="icon-button" icon="Editor/Icons/chevron-right.svg" tooltip="The tab after (Ctrl+Tab)"/>
        <Button id="viewer-open" class="icon-button" icon="Editor/Icons/open.svg" tooltip="Open model files (glTF, GLB, FBX, OBJ), or drop them on the window (Ctrl+O)"/>
        <Button id="viewer-recent" class="icon-button" icon="Editor/Icons/list.svg" tooltip="The models opened and the folders browsed lately"/>
        <Button id="viewer-preferences" class="icon-button" icon="Editor/Icons/settings.svg" tooltip="Preferences: screenshots, the view's defaults, thumbnails and the cache"/>
    </Panel>
    <Panel class="viewer-body">
        <!-- Browse: the folders, the grid and the chosen model's details, a splitter's panes. -->
        <Splitter id="viewer-browser" class="viewer-browser page-body" axis="horizontal" weights="0.2 0.56 0.24">
            <Panel class="viewer-folders page-pane">
                <Panel class="panel-toolbar viewer-folders-bar">
                    <Button id="viewer-choose-folder" class="ghost" icon="Editor/Icons/folder-open.svg" text="Choose folder" tooltip="The folder to browse"/>
                </Panel>
                <TreeView id="viewer-folder-tree" class="viewer-folder-tree"/>
            </Panel>
            <Panel class="viewer-grid-pane page-pane">
                <Panel class="panel-toolbar viewer-filter">
                    <Panel class="search viewer-filter-name">
                        <Image class="search-icon" src="Editor/Icons/search.svg"/>
                        <TextField id="viewer-filter-name" class="search-field" placeholder="Filter by name"/>
                        <Button id="viewer-filter-clear" class="slot-button" icon="Editor/Icons/close.svg" tooltip="Clear the filter"/>
                    </Panel>
                    <CheckBox id="viewer-filter-rigged" class="choice" text="Rigged" tooltip="Only models with a skeleton (known once drawn)"/>
                    <CheckBox id="viewer-filter-animated" class="choice" text="Animated" tooltip="Only models with clips (known once drawn)"/>
                    <CheckBox id="viewer-filter-library" class="choice" text="In library" tooltip="Only models already in the library"/>
                    <Label id="viewer-grid-count" class="viewer-grid-count"/>
                    <Slider id="viewer-tile-size" class="viewer-tile-size" min="0" max="2" step="1" tooltip="The tiles' size: small, medium or large"/>
                    <Button id="viewer-select-all" class="icon-button" icon="Editor/Icons/select.svg" tooltip="Select every model shown (Ctrl+A); Ctrl+click and Shift+click select some. Right-click the selection, or drag it onto a collection in the Library tab, to add it"/>
                </Panel>
                <ListView id="viewer-grid" class="viewer-tiles" selection-mode="multi"/>
            </Panel>
            <Panel id="browse-details" class="viewer-panel page-pane">
                <Panel class="component-header"><Label class="component-name" text="Model"/></Panel>
                <Label id="browse-details-empty" class="viewer-empty-note" text="Select a model to see its details."/>
                <Panel id="browse-details-model" class="viewer-details">
                    <Panel class="prop-row">
                        <Label id="browse-file" class="viewer-file"/>
                        <Button id="browse-open" class="icon-button" icon="Editor/Icons/open.svg" tooltip="Open it in a tab (or double-click its tile)"/>
                    </Panel>
                    <Panel id="browse-stats" class="viewer-stats"/>
                    <Panel class="component-header"><Label class="component-name" text="Library"/></Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="In"/>
                        <Panel id="browse-lib-memberships" class="prop-stack viewer-memberships"/>
                    </Panel>
                    <Panel class="prop-row">
                        <Label class="prop-name" text="Add to"/>
                        <ComboBox id="browse-lib-add-target" tooltip="A collection to put this model in"/>
                        <Button id="browse-lib-add" class="icon-button" icon="Editor/Icons/plus.svg" tooltip="Put this model in the collection (it joins the library)"/>
                    </Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="Tags"/>
                        <Panel class="prop-stack viewer-tags">
                            <Panel id="browse-lib-tags" class="viewer-chips"/>
                            <TextField id="browse-lib-tag" placeholder="Add a tag (Enter)"/>
                        </Panel>
                    </Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="Note"/>
                        <TextArea id="browse-note" class="viewer-note-area" placeholder="A note on this model"/>
                    </Panel>
                </Panel>
            </Panel>
        </Splitter>
        <!-- Library: the collections and tags, the grid and the chosen model's details, a splitter's panes. -->
        <Splitter id="viewer-library" class="viewer-browser page-body" axis="horizontal" weights="0.2 0.56 0.24">
            <Panel class="viewer-folders page-pane">
                <Panel class="panel-toolbar viewer-lib-bar">
                    <Label class="viewer-pane-title" text="Collections"/>
                    <Spacer/>
                    <Button id="viewer-lib-new" class="icon-button" icon="Editor/Icons/plus.svg" tooltip="A new collection inside the one chosen (else at the top); right-click a row for more"/>
                    <Button id="viewer-lib-undo" class="icon-button" icon="Editor/Icons/undo.svg" tooltip="Undo the last change to the library"/>
                </Panel>
                <TreeView id="viewer-lib-tree" class="viewer-folder-tree"/>
            </Panel>
            <Panel class="viewer-grid-pane page-pane">
                <Panel class="panel-toolbar viewer-filter">
                    <Panel class="search viewer-lib-search">
                        <Image class="search-icon" src="Editor/Icons/search.svg"/>
                        <TextField id="viewer-lib-search" class="search-field" placeholder="Search: words, tag:x, collection:x, rigged, animated, missing"/>
                        <Button id="viewer-lib-clear" class="slot-button" icon="Editor/Icons/close.svg" tooltip="Clear the search"/>
                    </Panel>
                    <CheckBox id="viewer-lib-everywhere" class="choice" text="Everywhere" tooltip="Search the whole library, not just the collection chosen"/>
                    <CheckBox id="viewer-lib-sub" class="choice" text="Sub-collections" checked="true" tooltip="With the models of the collections inside"/>
                    <Label id="viewer-lib-count" class="viewer-grid-count"/>
                    <Slider id="viewer-lib-tile-size" class="viewer-tile-size" min="0" max="2" step="1" tooltip="The tiles' size: small, medium or large"/>
                </Panel>
                <ListView id="viewer-lib-grid" class="viewer-tiles" selection-mode="multi"/>
            </Panel>
            <Panel id="library-details" class="viewer-panel page-pane">
                <Panel class="component-header"><Label class="component-name" text="Model"/></Panel>
                <Label id="library-details-empty" class="viewer-empty-note" text="Select a model to see its details."/>
                <Panel id="library-details-model" class="viewer-details">
                    <Panel class="prop-row">
                        <Label id="library-file" class="viewer-file"/>
                        <Button id="library-open" class="icon-button" icon="Editor/Icons/open.svg" tooltip="Open it in a tab (or double-click its tile)"/>
                    </Panel>
                    <Panel id="library-stats" class="viewer-stats"/>
                    <Panel class="component-header"><Label class="component-name" text="Library"/></Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="In"/>
                        <Panel id="library-lib-memberships" class="prop-stack viewer-memberships"/>
                    </Panel>
                    <Panel class="prop-row">
                        <Label class="prop-name" text="Add to"/>
                        <ComboBox id="library-lib-add-target" tooltip="A collection to put this model in"/>
                        <Button id="library-lib-add" class="icon-button" icon="Editor/Icons/plus.svg" tooltip="Put this model in the collection (it joins the library)"/>
                    </Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="Tags"/>
                        <Panel class="prop-stack viewer-tags">
                            <Panel id="library-lib-tags" class="viewer-chips"/>
                            <TextField id="library-lib-tag" placeholder="Add a tag (Enter)"/>
                        </Panel>
                    </Panel>
                    <Panel class="prop-row viewer-lib-row">
                        <Label class="prop-name" text="Note"/>
                        <TextArea id="library-note" class="viewer-note-area" placeholder="A note on this model"/>
                    </Panel>
                </Panel>
            </Panel>
        </Splitter>
        <!-- A model tab: its own bar, as an editor page's, over its view and its side panel (a splitter's panes). -->
        <Panel id="viewer-model-page" class="viewer-model-page">
            <ToolBar id="viewer-page-bar" class="page-toolbar">
                <ToolButton id="viewer-frame" icon="Editor/Icons/frame-selection.svg" tooltip="Frame the model (F)"/>
                <ToolButton id="viewer-screenshot" icon="Editor/Icons/camera.svg" tooltip="Save this view as a PNG: the 3D view only, grid and bones as shown (where and how named: Preferences)"/>
                <Spacer/>
                <ToolButton id="viewer-panel-toggle" toggle="true" checked="true" icon="Editor/Icons/inspector.svg" tooltip="Show or hide the side panel"/>
            </ToolBar>
            <Splitter id="viewer-model-body" class="page-body" axis="horizontal" weights="0.76 0.24">
            <Panel id="viewer-stage" class="viewer-stage page-pane">
            <Panel id="viewer-view" class="viewer-view">
                <Panel id="viewer-empty" class="state-box viewer-empty">
                    <Label class="state-title" text="No model open"/>
                    <Label id="viewer-empty-text" class="state-text" text="Drop a glTF, GLB, FBX or OBJ file here, or use Open."/>
                </Panel>
            </Panel>
            <Panel id="viewer-anim" class="panel-toolbar viewer-anim">
                <ComboBox id="viewer-clip" class="viewer-clip" tooltip="The clip that plays"/>
                <Button id="viewer-play" class="icon-button" icon="Editor/Icons/pause.svg" tooltip="Play or pause"/>
                <Button id="viewer-stop" class="icon-button" icon="Editor/Icons/stop.svg" tooltip="Back to the start, paused"/>
                <Button id="viewer-step-back" class="icon-button" icon="ModelViewer/Icons/step-back.svg" tooltip="A frame back"/>
                <Button id="viewer-step" class="icon-button" icon="ModelViewer/Icons/step-forward.svg" tooltip="A frame forward"/>
                <Slider id="viewer-scrub" class="viewer-scrub" min="0" max="1" value="0" tooltip="Drag to a moment of the clip"/>
                <Label id="viewer-time" class="viewer-time" text="0.00 / 0.00 s"/>
                <CheckBox id="viewer-loop" class="choice" text="Loop" checked="true" tooltip="Start over at the end"/>
                <ComboBox id="viewer-speed" class="viewer-speed" items="0.25x|0.5x|1x|2x" selected="2" tooltip="Playback speed"/>
            </Panel>
        </Panel>
        <Panel id="viewer-panel" class="viewer-panel page-pane">
            <Panel class="component-header"><Label class="component-name" text="Model"/></Panel>
            <Label id="viewer-file" class="viewer-file"/>
            <Panel id="viewer-stats" class="viewer-stats"/>
            <Panel class="component-header"><Label class="component-name" text="Library"/></Panel>
            <Panel class="prop-row viewer-lib-row">
                <Label class="prop-name" text="In"/>
                <Panel id="viewer-lib-memberships" class="prop-stack viewer-memberships"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Add to"/>
                <ComboBox id="viewer-lib-add-target" tooltip="A collection to put this model in"/>
                <Button id="viewer-lib-add" class="icon-button" icon="Editor/Icons/plus.svg" tooltip="Put this model in the collection (it joins the library)"/>
            </Panel>
            <Panel class="prop-row viewer-lib-row">
                <Label class="prop-name" text="Tags"/>
                <Panel class="prop-stack viewer-tags">
                    <Panel id="viewer-lib-tags" class="viewer-chips"/>
                    <TextField id="viewer-lib-tag" placeholder="Add a tag (Enter)"/>
                </Panel>
            </Panel>
            <Panel class="prop-row viewer-lib-row">
                <Label class="prop-name" text="Note"/>
                <TextArea id="viewer-note" class="viewer-note-area" placeholder="A note on this model"/>
            </Panel>
            <Panel class="component-header"><Label class="component-name" text="View"/></Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Exposure"/>
                <Slider id="viewer-exposure" min="-4" max="4" step="0.1" value="0" tooltip="Stops brighter or darker"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Ambient"/>
                <Slider id="viewer-ambient" min="0" max="2" step="0.05" value="0.3" tooltip="The flat fill on top of the sky's light"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Sky"/>
                <Slider id="viewer-sky" min="0" max="3" step="0.05" value="1" tooltip="The sky's brightness and the light it gives"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Turntable"/>
                <CheckBox id="viewer-turntable" tooltip="Turn the model slowly about its middle"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Grid"/>
                <CheckBox id="viewer-show-grid" tooltip="Draw the ground grid (kept as a preference)"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Skeleton"/>
                <CheckBox id="viewer-skeleton" tooltip="Draw the bones over the model"/>
            </Panel>
            <Panel class="prop-row">
                <Label class="prop-name" text="Loose textures"/>
                <CheckBox id="viewer-loose" checked="true" tooltip="A material that lost its texture takes the image beside the model with its name (or the model's, or the first); for models opened from now on"/>
            </Panel>
            <Spacer/>
            <Label class="preview-hint viewer-hint" text="Alt drag orbits · right drag looks, WASD flies · middle drag pans · wheel zooms · F frames"/>
        </Panel>
            </Splitter>
        </Panel>
    </Panel>
</Panel>
