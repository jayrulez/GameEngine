<!--
  The GUI lab's showcase (G6 of Documentation/Specs/vg-and-gui-lab.md): a game's main menu in
  markup, played by mouse, keyboard or gamepad (G7: the menu wraps, settings, loading and the modal
  keep focus inside them, Stay is the modal's safe default), styled by menu.css and brought to life by menu.as. The host loads this, sizes the root
  and its layers (backdrop, menu screen, loading screen, modal) to the window, binds {{name}}
  values to the GUI's data, and runs the script.
-->
<Panel id="showcase" class="showcase" display="stack" justify-items="start" align-items="start">
    <!-- The backdrop: soft orbs drifting behind everything (their places are transforms). -->
    <Panel id="backdrop" class="backdrop" display="stack" justify-items="start" align-items="start">
        <Label class="orb orb-a"/>
        <Label class="orb orb-b"/>
        <Label class="orb orb-c"/>
    </Panel>

    <!-- The menu screen: the title fixed in the upper third, and below it one slot that the main
         menu and the settings take in turn, top-aligned so neither moves the title. -->
    <Panel id="stage" class="stage" flex-direction="column" align-items="center" gap="18">
        <Label id="title" class="title" text="AURORA"/>
        <Label id="subtitle" class="subtitle" text="Welcome back, {{name}}"/>

        <Panel id="main" class="panel menu enter" flex-direction="column" align-items="center" gap="12" nav-scope="wrap" nav-default="play">
            <Button id="play" class="menu-btn primary" text="Play"/>
            <Button id="settings-btn" class="menu-btn" text="Settings"/>
            <Button id="quit" class="menu-btn" text="Quit"/>
        </Panel>

        <!-- Settings: a page of the menu, in its place; frosted, bound to the GUI's data both ways. -->
        <Panel id="settings" class="panel glass" flex-direction="column" align-items="center" gap="14" nav-scope="contain">
            <Label class="panel-title" text="Settings"/>
            <Panel class="row" flex-direction="row" align-items="start" gap="14">
                <Label class="row-label" text="Volume"/>
                <Slider value="{{volume}}" class="row-slider"/>
                <Label id="volume-text" class="row-value"/>
            </Panel>
            <Panel class="row" flex-direction="row" align-items="start" gap="14">
                <Label class="row-label" text="Music"/>
                <CheckBox checked="{{music}}" class="row-check"/>
                <Label id="music-text" class="row-value"/>
            </Panel>
            <Panel class="row" flex-direction="row" align-items="start" gap="14">
                <Label class="row-label" text="Name"/>
                <TextField text="{{name}}" class="row-field"/>
            </Panel>
            <Button id="settings-back" class="menu-btn small" text="Back"/>
        </Panel>
    </Panel>

    <!-- Loading: a screen of its own, the status and bar low and centred. -->
    <Panel id="loading" class="loading-screen" flex-direction="column" justify-content="end" align-items="center" gap="16" nav-scope="contain">
        <Label class="loading-status" text="{{status}}"/>
        <ProgressBar value="{{progress}}" class="loading-bar"/>
        <Button id="loading-back" class="menu-btn small" text="Back"/>
    </Panel>

    <!-- Quit: a modal over the whole screen, which dims and blurs what is behind it and takes
         every click until it is answered. -->
    <Panel id="modal" class="modal" flex-direction="column" justify-content="center" align-items="center" nav-scope="contain" nav-default="confirm-no">
        <Panel id="confirm" class="panel glass" flex-direction="column" align-items="center" gap="14">
            <Label class="panel-title" text="Leave so soon?"/>
            <Panel class="confirm-row" flex-direction="row" align-items="start" gap="14">
                <Button id="confirm-yes" class="menu-btn small danger" text="Leave"/>
                <Button id="confirm-no" class="menu-btn small" text="Stay"/>
            </Panel>
        </Panel>
    </Panel>
</Panel>
