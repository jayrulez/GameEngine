<LinearLayout id="page-binding" class="page" orientation="vertical" spacing="18" wrap-content="true">
    <Label class="page-title" text="Data binding"/>
    <Label class="page-lead" wrap="true"
           text="Markup bound to the GUI's data by name, in double braces: the slider, the checkbox and the field write their values back, and everything reading them follows. No handler is wired. The game menu reads the same values."/>

    <LinearLayout class="section" orientation="vertical" spacing="12" wrap-content="true">
        <Label class="section-title" text="Bound both ways"/>
        <LinearLayout class="row" orientation="horizontal" spacing="12">
            <Label class="text label-col" text="Volume" vertical-align="middle"/>
            <Slider class="bind-slider" value="{{volume}}"/>
            <ProgressBar class="bind-bar" progress="{{volume}}"/>
            <Label id="binding-percent" class="text value-col" vertical-align="middle"/>
        </LinearLayout>
        <LinearLayout class="row" orientation="horizontal" spacing="12">
            <Label class="text label-col" text="Music" vertical-align="middle"/>
            <CheckBox class="bind-check" checked="{{music}}"/>
            <Label class="text" width="300" height="30" vertical-align="middle" text="music is {{music}}"/>
        </LinearLayout>
        <LinearLayout class="row" orientation="horizontal" spacing="12">
            <Label class="text label-col" text="Name" vertical-align="middle"/>
            <TextField class="bind-field" text="{{name}}"/>
            <Label class="text" width="220" height="30" vertical-align="middle" text="Hello, {{name}}!"/>
        </LinearLayout>
        <Label class="caption" text="The percentage is a script binding: a function of the volume, run again when it changes."/>
    </LinearLayout>
</LinearLayout>
