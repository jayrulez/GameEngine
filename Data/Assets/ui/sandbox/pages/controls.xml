<Panel id="page-controls" class="page" gap="18">
    <Label class="page-title" text="Controls"/>
    <Label class="page-lead" white-space="normal"
           text="The lab's widgets as markup makes them, themed by the built-in sheet. Each keeps its own state here; the Data binding page binds the same widgets to data."/>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Buttons"/>
        <Panel class="row" flex-direction="row" align-items="start" gap="12">
            <Button id="controls-add" class="btn" text="Add +1" tooltip="Counts a click"/>
            <Button id="controls-add5" class="btn accent" text="Add +5"/>
            <Button id="controls-reset" class="btn danger" text="Reset"/>
            <Button class="btn" text="Disabled" enabled="false"/>
        </Panel>
        <Panel class="row" flex-direction="row" align-items="start" gap="12">
            <Button id="controls-repeat" class="btn" text="Hold to add" repeat="true" tooltip="Repeats while held"/>
            <Button class="btn" text="Toggle" toggle="true"/>
            <Separator/>
            <Button id="controls-press" class="btn" text="On press" action-on="press"/>
            <Spacer/>
            <Label class="caption" width="90" height="36" vertical-align="middle" text="(a spacer)"/>
        </Panel>
        <Label class="caption" text="Clicks: {{clicks}}  (a label bound to the GUI's data; the script only counts)"/>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Toggles and choices"/>
        <Panel class="row" flex-direction="row" align-items="center" gap="24">
            <CheckBox id="controls-check" class="choice" text="A checkbox" checked="true"/>
            <CheckBox class="choice" text="Mixed" indeterminate="true" tooltip="Indeterminate until clicked"/>
            <ToggleSwitch class="choice" text="A switch" checked="true"/>
        </Panel>
        <Panel class="row" flex-direction="row" align-items="center" gap="24">
            <RadioButton class="choice" name="quality" text="Low"/>
            <RadioButton class="choice" name="quality" text="Medium" checked="true"/>
            <RadioButton class="choice" name="quality" text="High"/>
        </Panel>
        <Label class="caption" text="One group by its name: the arrows move round it. Each control is one button core."/>
        <Panel class="row" flex-direction="row" align-items="start" gap="12">
            <ComboBox id="controls-combo" class="combo" items="Apple|Banana|Cherry|Date|Elderberry" tooltip="A combo box"/>
        </Panel>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Values"/>
        <Panel class="row" flex-direction="row" align-items="start" gap="12">
            <Slider id="controls-slider" class="slider" value="0.35"/>
            <Label id="controls-slider-value" class="text" width="60" height="26" vertical-align="middle"/>
        </Panel>
        <ProgressBar id="controls-progress" class="progress"/>
        <Label class="caption" text="The bar and the number follow the slider through script bindings."/>
        <Panel class="row" flex-direction="row" align-items="center" gap="12">
            <NumberField class="number" min="0" max="100" value="42" suffix=" %" tooltip="Type an expression, drag across to scrub, or use the arrows"/>
            <NumberField class="number" min="0" max="10" step="0.25" value="1.5" prefix="$"/>
            <NumberField class="number" min="-50" max="50" integer="true" value="-7" suffix=" px"/>
        </Panel>
        <Panel class="ranges-row" flex-direction="row" align-items="center" gap="20">
            <Slider id="controls-vertical" class="vslider" orientation="vertical" min="0" max="100" step="5" value="40"/>
            <Panel gap="10">
                <Slider id="controls-stepped" class="slider" min="0" max="10" step="1" ticks="11" value="3"/>
                <Slider id="controls-freq" class="slider" min="20" max="20000" exponential="true" value="440"/>
                <ProgressBar class="progress" indeterminate="true"/>
            </Panel>
            <Label id="controls-ranges" class="caption ranges" white-space="normal"/>
        </Panel>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Scrolling"/>
        <Panel class="scroll-row" flex-direction="row" align-items="start" gap="16">
            <ScrollView id="controls-smooth" class="scroll-demo smooth">
            <Label class="scroll-line" text="Line 1 of a smooth list"/>
            <Label class="scroll-line" text="Line 2 of a smooth list"/>
            <Label class="scroll-line" text="Line 3 of a smooth list"/>
            <Label class="scroll-line" text="Line 4 of a smooth list"/>
            <Label class="scroll-line" text="Line 5 of a smooth list"/>
            <Label class="scroll-line" text="Line 6 of a smooth list"/>
            <Label class="scroll-line" text="Line 7 of a smooth list"/>
            <Label class="scroll-line" text="Line 8 of a smooth list"/>
            <Label class="scroll-line" text="Line 9 of a smooth list"/>
            <Label class="scroll-line" text="Line 10 of a smooth list"/>
            <Label class="scroll-line" text="Line 11 of a smooth list"/>
            <Label class="scroll-line" text="Line 12 of a smooth list"/>
            </ScrollView>
            <ScrollView id="controls-log" class="scroll-demo" stick-to-end="true">
                <Label class="scroll-line" text="The log keeps to its newest line"/>
            </ScrollView>
            <Button id="controls-log-add" class="btn" text="Add a line" repeat="true"/>
        </Panel>
        <Label class="caption" white-space="normal" height="40"
               text="Left: the wheel eases (scroll-behavior: smooth) and thin bars show while it scrolls or is hovered. Right: a log that follows its end until you scroll up, and again once you are back."/>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Text input"/>
        <TextField id="controls-field" class="field" placeholder="Type here: select, Ctrl+C/V..." max-length="32"/>
        <Label id="controls-echo" class="caption"/>
        <EditableLabel class="text editable" text="Double-click or F2 to rename me" tooltip="Return or leaving commits, Escape cancels"/>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="A list and images"/>
        <Panel width="590" height="170" flex-direction="row" align-items="start" gap="16">
            <ListBox id="controls-list" class="list" items="Item 1|Item 2|Item 3|Item 4|Item 5|Item 6|Item 7|Item 8|Item 9|Item 10|Item 11|Item 12"/>
            <Panel id="controls-image" class="image-host" display="stack" justify-items="start" align-items="start"/>
            <Image class="logo" src="Assets/images/logo.png" object-fit="contain" tooltip="An Image from markup: src, object-fit: contain"/>
        </Panel>
    </Panel>
</Panel>
