<Panel id="page-motion" class="page" gap="18">
    <Label class="page-title" text="Motion"/>
    <Label class="page-lead" white-space="normal"
           text="Every property transitions and animates, with real easings: transitions on hover, keyframes of opacity, colour and transforms, and the easing functions side by side."/>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Transitions: hover the cards"/>
        <Panel class="card-row" flex-direction="row" align-items="start" gap="16">
            <Label class="lift lift-back" text="overshoot"/>
            <Label class="lift lift-ease" text="ease"/>
            <Label class="lift lift-steps" text="steps(4)"/>
        </Panel>
    </Panel>

    <Panel class="section" gap="12">
        <Label class="section-title" text="Keyframes"/>
        <Panel class="row" flex-direction="row" align-items="center" gap="12">
            <Label class="dot pulse-fast"/><Label class="dot pulse"/><Label class="dot pulse-slow"/><Label class="dot blink"/>
            <Label class="swatch colorcycle"/>
            <Label class="sway" text="sway"/>
        </Panel>
        <Label class="caption" text="Opacity at three rates and a blink, a background colour cycling, a transform swaying back and forth."/>
    </Panel>

    <Panel class="section" gap="8">
        <Label class="section-title" text="Easing functions"/>
        <Panel class="ease-row" flex-direction="row" align-items="start" gap="12">
            <Label class="ease-name" text="linear"/><Panel class="track" display="stack" justify-items="start" align-items="start"><Label class="ball e-linear"/></Panel>
        </Panel>
        <Panel class="ease-row" flex-direction="row" align-items="start" gap="12">
            <Label class="ease-name" text="ease-in-out"/><Panel class="track" display="stack" justify-items="start" align-items="start"><Label class="ball e-inout"/></Panel>
        </Panel>
        <Panel class="ease-row" flex-direction="row" align-items="start" gap="12">
            <Label class="ease-name" text="cubic-bezier"/><Panel class="track" display="stack" justify-items="start" align-items="start"><Label class="ball e-back"/></Panel>
        </Panel>
        <Panel class="ease-row" flex-direction="row" align-items="start" gap="12">
            <Label class="ease-name" text="steps(6)"/><Panel class="track" display="stack" justify-items="start" align-items="start"><Label class="ball e-steps"/></Panel>
        </Panel>
    </Panel>
</Panel>
